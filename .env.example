# نمونهٔ متغیرهای محیطی داشبورد ایجنتیک تایلندگرد
# این فایل را کپی کنید: cp .env.example .env.local
# و مقدارهای واقعی را فقط در .env.local بگذارید (هرگز کامیت نشود)
# SUPABASE_URL و NEXT_PUBLIC_SUPABASE_URL می‌توانند یک مقدار داشته باشند
# SUPABASE_SERVICE_ROLE_KEY و SUPABASE_SERVICE_KEY هم همین‌طور

# آدرس پروژهٔ سوپابیس (عمومی)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# آدرس و کلید سرویس سوپابیس (فقط سمت سرور؛ نام‌های قدیمی‌تر پروژه)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# کلید سرویس سوپابیس (نام قراردادی زیرساخت؛ با بالایی یکسان است)
SUPABASE_SERVICE_KEY=

# رمز ورود پنل ادمین
ADMIN_PASSWORD=

# راز سشن/احراز (در صورت نیاز)
AUTH_SECRET=

# ربات تلگرام برای اعلان‌ها
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# درگاه مدل زبانی
LLM_API_KEY=
LLM_API_BASE=

# گیت‌هاب: توکن شخصی (classic) با دسترسی repo برای «تاریخچه تغییرات سایت»
# اگر خالی بماند، می‌توان توکن را در صفحهٔ تنظیمات داشبورد هم وارد کرد
GITHUB_TOKEN=
